# 🔒 Security Environment Variables
# Copy this to your .env file and customize as needed

# Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Application Configuration
PORT=3001
API_PREFIX="api/v1"

# Frontend Configuration (for CORS)
FRONTEND_URL="http://localhost:3000"

# Security Settings
HELMET_CSP_SCRIPT_SRC="'self' 'unsafe-eval'"  # Allow eval for development
THROTTLE_TTL=60000  # Time window in milliseconds
THROTTLE_LIMIT=100  # Requests per time window

# Logging Configuration
LOG_LEVEL="debug"

# 🔒 Production Security Recommendations:
# - Set NODE_ENV=production
# - Use strong JWT_SECRET (32+ characters)
# - Set FRONTEND_URL to your actual domain
# - Reduce THROTTLE_LIMIT for stricter rate limiting
# - Use HTTPS certificates
# - Set up proper logging and monitoring
