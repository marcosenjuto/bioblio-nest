        },
        {
          "name": "Get Material Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/materials/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["materials", "statistics"]
            }
          }
        }
      ]
    },
